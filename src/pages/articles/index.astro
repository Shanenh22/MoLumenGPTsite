---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const articles = [
  ['New Moon in Pisces', 'February 27, 2025', 'Release, flow, dream, welcome.'],
  ['New Moon in Aquarius', 'January 2025', 'New ideas, careful expression, and a fresh chapter.'],
  ['New Moon in Sagittarius', 'December 1, 2024', 'Freedom from—and freedom to.'],
  ['New Moon in Scorpio', 'November 2024', 'A deep look at a season of change.'],
  [
    'New Moon Solar Eclipse in Libra',
    'October 2024',
    'Relationship, balance, and eclipse-season reflection.',
  ],
  ['New Moon in Virgo', 'September 2024', 'Practical attention at the start of a lunar cycle.'],
];
---

<BaseLayout title="Articles"
  ><PageHero
    eyebrow="Il:Lumen:ations archive"
    title="Astrology connected to the life beneath it."
    lede="Existing essays are inventoried here for editorial and ownership review before full migration."
  /><section class="section">
    <div class="container article-list">
      {
        articles.map((article) => (
          <article>
            <>
              <p>{article[1]}</p>
              <div>
                <>
                  <h2>{article[0]}</h2>
                  <p>{article[2]}</p>
                  <span class="review">Migration review pending</span>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section></BaseLayout
><style>
  .article-list article {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--stone);
  }
  .article-list h2 {
    font-size: var(--step-2);
  }
  .review {
    color: var(--clay);
    font-size: var(--step--1);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .article-list article {
      grid-template-columns: 1fr;
    }
  }
</style>
