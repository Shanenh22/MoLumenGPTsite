---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { services, type Service } from '../../data/services';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
const serviceUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.purpose,
  url: serviceUrl.href,
  provider: { '@type': 'Organization', name: 'Mo Lumen Astrology' },
  offers: {
    '@type': 'Offer',
    price: service.priceAmount,
    priceCurrency: service.currency,
    availability: 'https://schema.org/InStock',
    url: new URL(`/book/?service=${service.slug}`, serviceUrl.origin).href,
  },
};
---

<BaseLayout title={service.shortName} description={service.purpose}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <PageHero eyebrow="Astrology reading" title={service.shortName} lede={service.purpose} />
  <section class="section">
    <div class="container grid detail-grid">
      <article class="prose">
        <p class="lede">{service.description}</p>
        <h2>Who this reading may help</h2><ul>
          {service.bestFor.map((item) => <li>{item}</li>)}
        </ul><h2>Eligibility</h2><p>{service.eligibility}</p><h2>What Mo needs</h2><p>
          {service.birthInfo}. Birth details are sensitive personal information. They should be
          submitted only through the approved booking provider—not by analytics, URLs, or this
          website’s storage.
        </p><h2>Before you book</h2><p>
          Review the final booking, cancellation, and rescheduling terms presented with the
          appointment before payment.
        </p>
      </article><aside class="booking-card">
        <p class="eyebrow">At a glance</p><dl>
          <div><dt>Duration</dt><dd>{service.duration}</dd></div><div>
            <dt>Price</dt><dd>{service.price}</dd>
          </div><div><dt>Format</dt><dd>{service.format}</dd></div><div>
            <dt>Method</dt><dd>{service.method}</dd>
          </div>
        </dl><a class="button" href={`/book/?service=${service.slug}`}>Review booking details</a><a
          href="/reading-finder/">Not sure? Use the Reading Finder</a
        >
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .detail-grid {
    grid-template-columns: minmax(0, 1fr) 22rem;
    align-items: start;
    gap: var(--space-7);
  }
  .booking-card {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1rem;
    padding: var(--space-5);
    border: 1px solid var(--stone);
    border-radius: var(--radius-md);
    background: var(--paper-light);
    box-shadow: var(--shadow);
  }
  .booking-card dl {
    margin: 0;
  }
  .booking-card dl div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--stone);
  }
  .booking-card dt {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
  }
  .booking-card dd {
    margin: 0.2rem 0 0;
    color: var(--brown);
  }
  @media (max-width: 800px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .booking-card {
      position: static;
    }
  }
</style>
