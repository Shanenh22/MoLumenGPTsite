---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Mo's Approach"
  ><PageHero
    eyebrow="Approach"
    title="Perspective, timing, and choice—not certainty."
    lede="Astrology can name patterns and seasons. It cannot make your decisions, remove complexity, or guarantee an outcome."
  /><section class="section">
    <div class="container grid grid-3">
      <article class="card">
        <h2>Grounded</h2><p>
          We connect symbols to the real relationships, decisions, and circumstances you are living.
        </p>
      </article><article class="card">
        <h2>Nonfatalistic</h2><p>
          A chart describes possibilities and tendencies. You retain responsibility and room to
          respond.
        </p>
      </article><article class="card">
        <h2>Compassionate</h2><p>
          No fear-based predictions, manufactured urgency, or judgment about how a pattern has
          appeared in your life.
        </p>
      </article>
    </div>
  </section><section class="section surface">
    <div class="container reading-width prose">
      <h2>What a reading can do</h2><p>
        It can offer language for patterns, context for timing, and another angle on a question. It
        can help you prepare and reflect.
      </p><h2>What it cannot do</h2><p>
        It cannot promise certainty or replace medical, psychological, legal, or financial care. It
        cannot remove your choice.
      </p>
    </div>
  </section></BaseLayout
>
