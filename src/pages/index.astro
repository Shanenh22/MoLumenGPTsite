---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
const serviceImages: Record<string, string> = {
  'new-client-natal-chart-reading-90': 'natal-reading',
  'new-client-natal-chart-reading-60': 'natal-reading',
  'life-changes-consultation': 'life-changes',
  'solar-return-reading': 'solar-return',
};
---

<BaseLayout>
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Astrology readings for real life</p>
        <h1>See yourself in a <em>new light.</em></h1>
        <p class="lede">
          Your chart is not a verdict. It is a way to notice patterns, understand the season you are
          in, and make more conscious choices about what comes next.
        </p>
        <div class="button-row">
          <a class="button" href="/reading-finder/">Find Your Reading</a><a
            class="button secondary"
            href="/about/">Meet Mo</a
          >
        </div>
        <p class="reassurance">
          Warm, private conversations Â· Beginners welcome Â· Your choices remain your own
        </p>
      </div>
      <figure class="hero-art">
        <img class="hero-portrait" src="/images/mo-2.webp" alt="Mo Lumen smiling warmly" width="1536" height="2048" decoding="async" fetchpriority="high" />
        <figcaption><span aria-hidden="true">✦</span><strong>Hi, I’m Mo.</strong> Practical astrology, warmly shared.</figcaption>
      </figure>
    </div>
  </section>

  <section class="values-ribbon" aria-label="What guides Mo's work">
    <div class="container values-track">
      <div><span aria-hidden="true">◎</span><p><strong>Insight</strong><small>See patterns clearly</small></p></div>
      <div><span aria-hidden="true">☽</span><p><strong>Empowerment</strong><small>Choose with confidence</small></p></div>
      <div><span aria-hidden="true">♡</span><p><strong>Compassion</strong><small>A safe place to explore</small></p></div>
      <div><span aria-hidden="true">↗</span><p><strong>Growth</strong><small>Turn insight into action</small></p></div>
      <div><span aria-hidden="true">✦</span><p><strong>Your Path</strong><small>Your timing, your way</small></p></div>
    </div>
  </section>

  <section class="section recognition surface">
    <div class="container grid grid-2">
      <div>
        <p class="eyebrow">A thoughtful pause</p><h2>
          You may be here because something is asking for your attention.
        </h2>
      </div>
      <div class="recognition-list">
        <p>Perhaps you are at a threshold and want perspective before choosing a direction.</p>
        <p>
          Perhaps a relationship keeps revealing the same patternâ€”and you are ready to understand it
          differently.
        </p>
        <p>
          Or perhaps you simply want language for the person you have always sensed yourself to be.
        </p>
      </div>
    </div>
  </section>

  <section class="section finder-invite">
    <div class="container finder-card">
      <div>
        <p class="eyebrow">Two minutes to clarity</p><h2>Not sure which reading fits?</h2><p>
          Answer a few plain-language questions. The Reading Finder recommends only services Mo
          currently offersâ€”and you are always free to choose another.
        </p>
      </div>
      <a class="button light" href="/reading-finder/">Start the Reading Finder</a>
    </div>
  </section>

  <section class="section surface">
    <div class="container">
      <p class="eyebrow">Ways to work together</p><h2>Begin with what you want to understand.</h2><p
        class="lede"
      >
        You do not need to know the astrological terminology. Start with your situation; Mo brings
        the method.
      </p>
      <div class="grid grid-2 service-grid">
        {
          services
            .filter((service) => service.featured)
            .slice(0, 4)
            .map((service, index) => (
              <article class="service-card card">
                <>
                  <img class="service-image" src={`/images/${serviceImages[service.slug] ?? 'chart-detail'}.webp`} alt="" width="640" height="420" loading="lazy" decoding="async" />
                  <span class="number">0{index + 1}</span>
                  <h3>
                    <a href={`/readings/${service.slug}/`}>{service.shortName}</a>
                  </h3>
                  <p>{service.purpose}</p>
                  <p class="service-meta">{service.duration}</p>
                  <a href={`/readings/${service.slug}/`}>
                    Explore this reading <span aria-hidden="true">â†’</span>
                  </a>
                </>
              </article>
            ))
        }
      </div><div class="button-row">
        <a class="button secondary" href="/readings/">Compare all readings</a>
      </div>
    </div>
  </section>

  <section class="section about-preview">
    <div class="container grid grid-2">
      <figure class="portrait-placeholder"><img src="/images/mo-1.webp" alt="Mo Lumen smiling in her creative studio" width="1368" height="2048" loading="lazy" decoding="async" /></figure>
      <div>
        <p class="eyebrow">Meet your astrologer</p><h2>
          Classical technique. A teacherâ€™s clarity. A very human conversation.
        </h2><p>
          Mo is an astrologer, teacher, and writer who connects the language of a chart to the life
          you are actually living. Her approach is candid and compassionate, intuitive and
          practical.
        </p><blockquote>
          â€œI will connect your reading directly to your real-life situations and storiesâ€”not just
          flowery, feel-good platitudes.â€
        </blockquote><a class="button secondary" href="/about/">Meet Mo</a>
      </div>
    </div>
  </section>

  <section class="section navy-surface process">
    <div class="container">
      <p class="eyebrow">How a reading works</p><h2>
        A considered process, from question to conversation.
      </h2><ol class="process-grid">
        <li><span>1</span><h3>Choose</h3><p>Find the reading that fits your situation.</p></li><li>
          <span>2</span><h3>Schedule</h3><p>
            Review details, choose a time, and share only what is needed.
          </p>
        </li><li>
          <span>3</span><h3>Prepare</h3><p>Mo studies your charts before the session.</p>
        </li><li>
          <span>4</span><h3>Meet</h3><p>Explore the patterns together, with room for questions.</p>
        </li>
      </ol><a class="button light" href="/how-readings-work/">See the full process</a>
    </div>
  </section>

  <section class="section pathways">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <p class="eyebrow">Learn at your own pace</p><h2>Astrology in plain language.</h2>
        </div><p class="lede">
          Understand the four building blocks of a chartâ€”planets, signs, houses, and aspectsâ€”without
          reducing a person to a list of traits.
        </p>
      </div><div class="grid grid-3 pathway-grid">
        <a class="card" href="/tools/explore-your-chart/"
          ><span aria-hidden="true">â—Ž</span><h3>Explore Your Chart</h3><p>
            An interactive, non-personalized guide to how a chart is organized.
          </p></a
        ><a class="card" href="/current-sky/"
          ><span aria-hidden="true">â˜¼</span><h3>Current Sky</h3><p>
            Learn what is moving overhead and how Mo approaches its themes.
          </p></a
        ><a class="card" href="/explore/"
          ><span aria-hidden="true">âœ¦</span><h3>Astrology Library</h3><p>
            Build a grounded foundation, one clear concept at a time.
          </p></a
        >
      </div>
    </div>
  </section>

  <section class="section final-cta surface">
    <div class="container reading-width">
      <p class="eyebrow">A calm next step</p><h2>
        Your chart can offer perspective. What you do with it is yours.
      </h2><div class="button-row">
        <a class="button" href="/reading-finder/">Find Your Reading</a><a
          class="button secondary"
          href="/contact/">Ask Mo a question</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: clamp(42rem, 82vh, 52rem);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 82% 22%, rgba(46,113,172,.46), transparent 24rem), radial-gradient(circle at 18% 88%, rgba(215,101,77,.24), transparent 28rem), var(--navy);
    color: var(--white);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  h1 {
    max-width: 11ch;
  }
  h1 em {
    color: #ffb08f;
    font-weight: 400;
  }
  .reassurance {
    margin-top: var(--space-4);
    color: rgba(255, 253, 248, 0.72);
    font-size: var(--step--1);
  }
  .hero-art {
    position: relative;
    min-height: 34rem;
    margin-left: auto;
    width: min(100%, 31rem);
  }
  .hero-art::before { position: absolute; inset: 1.25rem -1.25rem -1.25rem 1.25rem; border: 1px solid rgba(231,161,65,.58); border-radius: 48% 48% 1.5rem 1.5rem; content: ''; }
  .hero-portrait { position: relative; width: 100%; height: 34rem; border: 1px solid rgba(255,255,255,.28); border-radius: 48% 48% 1.5rem 1.5rem; object-fit: cover; object-position: center 33%; box-shadow: var(--shadow-color); }
  .hero-art figcaption { position: relative; width: fit-content; margin: -1.35rem auto 0; padding: .8rem 1.15rem; border-radius: 999px; background: var(--paper-light); box-shadow: var(--shadow-color); color: var(--navy); font-size: .82rem; }
  .hero-art figcaption span { margin-right: .35rem; color: var(--coral); }
  .hero-art figcaption strong { margin-right: .25rem; }
  .home-hero .eyebrow { color: var(--gold-light); }
  .home-hero .button { background: var(--coral); border-color: var(--coral); }
  .home-hero .button.secondary { border-color: rgba(255,255,255,.65); background: rgba(15,31,53,.24); color: var(--white); }
  .home-hero .lede { color: rgba(255,253,248,.84); }
  .values-ribbon { border-bottom: 1px solid var(--stone); background: var(--paper-light); }
  .values-track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding-block: 1.25rem; }
  .values-track > div { display: flex; min-width: 0; align-items: center; gap: .75rem; padding: .5rem 1rem; border-right: 1px solid var(--stone); }
  .values-track > div:last-child { border-right: 0; }
  .values-track p { margin: 0; }
  .values-track span { flex: 0 0 auto; color: var(--coral); font-size: 1.8rem; }
  .values-track div:nth-child(even) span { color: var(--cobalt); }
  .values-track strong, .values-track small { display: block; }
  .values-track strong { color: var(--navy); font-size: .75rem; letter-spacing: .07em; text-transform: uppercase; }
  .values-track small { margin-top: .15rem; color: var(--brown); font-size: .7rem; line-height: 1.3; }
  .recognition-list p {
    padding: 0 0 1rem 1.25rem;
    border-left: 1px solid var(--gold);
  }
  .finder-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 88% 15%, rgba(255,255,255,.18), transparent 14rem), linear-gradient(135deg, var(--coral), #b94f6c 54%, var(--cobalt));
    color: var(--white);
    box-shadow: var(--shadow);
  }
  .finder-card p {
    max-width: 42rem;
  }
  .service-grid {
    margin-top: var(--space-6);
  }
  .service-card {
    position: relative;
    padding-left: clamp(4rem, 7vw, 6rem);
  }
  .service-image { width: calc(100% + clamp(4rem, 7vw, 6rem)); height: 12rem; margin: calc(-1 * var(--space-5)) 0 1.5rem calc(-1 * clamp(4rem, 7vw, 6rem)); object-fit: cover; }
  .service-card:nth-child(4n + 1) { border-top: .35rem solid var(--coral); }
  .service-card:nth-child(4n + 2) { border-top: .35rem solid var(--cobalt); }
  .service-card:nth-child(4n + 3) { border-top: .35rem solid var(--saffron); }
  .service-card:nth-child(4n) { border-top: .35rem solid var(--sage); }
  .number {
    position: absolute;
    top: 1.6rem;
    left: 1.6rem;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.5rem;
  }
  .service-meta {
    color: var(--brown);
    font-weight: 700;
  }
  .about-preview blockquote {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 3px solid var(--gold);
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .portrait-placeholder {
    display: block;
    min-height: 34rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--stone);
    border-radius: 48% 48% var(--radius-lg) var(--radius-lg);
    background: var(--blush);
  }
  .portrait-placeholder img { width: 100%; height: 34rem; object-fit: cover; object-position: center 35%; }
  .process .eyebrow {
    color: var(--gold-light);
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
  }
  .process-grid li {
    padding-top: var(--space-4);
    border-top: 1px solid rgba(247, 241, 231, 0.25);
  }
  .process-grid span {
    display: inline-grid;
    width: 2.4rem;
    height: 2.4rem;
    place-content: center;
    border: 1px solid var(--gold-light);
    border-radius: 50%;
    color: var(--gold-light);
  }
  .process-grid h3 {
    margin-top: 1rem;
  }
  .pathway-grid {
    margin-top: var(--space-6);
  }
  .pathway-grid a {
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .pathway-grid a:hover {
    transform: translateY(-3px);
  }
  .pathway-grid span {
    color: var(--gold);
    font-size: 2.4rem;
  }
  .pathway-grid a:nth-child(1) span { color: var(--cobalt); }
  .pathway-grid a:nth-child(2) span { color: var(--coral); }
  .pathway-grid a:nth-child(3) span { color: var(--saffron); }
  @media (max-width: 800px) {
    .home-hero {
      min-height: auto;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      min-height: 29rem;
      margin: 0 auto 1rem;
    }
    .hero-portrait { height: 29rem; }
    .hero-art::before { inset: .8rem -.6rem -.6rem .8rem; }
    .values-track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .values-track > div { border-right: 0; border-bottom: 1px solid var(--stone); }
    .values-track > div:last-child { grid-column: 1 / -1; border-bottom: 0; }
    .finder-card {
      grid-template-columns: 1fr;
    }
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .hero-grid { padding-top: 3rem; }
    .hero-art { min-height: 25rem; }
    .hero-portrait { height: 25rem; }
    .hero-art figcaption { width: calc(100% - 1rem); border-radius: .85rem; text-align: center; }
    .values-track { grid-template-columns: 1fr; }
    .values-track > div:last-child { grid-column: auto; }
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

