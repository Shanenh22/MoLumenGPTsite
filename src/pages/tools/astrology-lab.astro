---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { planets, signs, houses, aspects, calculatedAspects, traditionalConditions } from '../../data/astrology-reference';
const glyphs = [
  ...planets.map(([symbol,name,keywords]) => ({symbol,name,group:'Planet',keywords})),
  ...signs.map(([symbol,name,keywords]) => ({symbol,name,group:'Sign',keywords})),
  ...aspects.map(({symbol,name,angle}) => ({symbol,name,group:'Aspect',keywords: angle + '° relationship'})),
];
---
<BaseLayout title="Astrology Lab" description="Interactive astrology learning tools for symbols, aspects, and chart synthesis.">
  <PageHero eyebrow="Interactive learning" title="The Astrology Lab" lede="Explore at your level. No birth data, account, prediction, or personal information required." />
  <section class="section"><div class="container lab" data-lab>
    <div class="lab-tabs" role="tablist" aria-label="Astrology Lab tools">
      <button role="tab" aria-selected="true" aria-controls="glyph-panel" id="glyph-tab">Glyph Explorer</button>
      <button role="tab" aria-selected="false" aria-controls="aspect-panel" id="aspect-tab" tabindex="-1">Aspect Calculator</button>
      <button role="tab" aria-selected="false" aria-controls="condition-panel" id="condition-tab" tabindex="-1">Planetary Condition</button>
      <button role="tab" aria-selected="false" aria-controls="placement-panel" id="placement-tab" tabindex="-1">Placement Builder</button>
    </div>
    <section id="glyph-panel" role="tabpanel" aria-labelledby="glyph-tab">
      <div class="tool-heading"><div><p class="level-tag newcomer">Newcomer friendly</p><h2>Glyph Explorer</h2><p>Search the symbols used in charts and tables.</p></div><label>Search symbols and terms <input type="search" data-glyph-search placeholder="Try Venus, square, or fire" /></label></div>
      <p class="result-count" data-glyph-count aria-live="polite">{glyphs.length} symbols shown</p>
      <div class="glyph-grid">{glyphs.map((item) => <article data-glyph={[item.name,item.group,item.keywords].join(' ').toLowerCase()}><span aria-hidden="true">{item.symbol}</span><div><small>{item.group}</small><h3>{item.name}</h3><p>{item.keywords}</p></div></article>)}</div>
      <p class="empty" data-glyph-empty hidden>No symbols match that search.</p>
    </section>
    <section id="aspect-panel" role="tabpanel" aria-labelledby="aspect-tab" data-aspects={JSON.stringify(calculatedAspects)} hidden>
      <div class="tool-heading"><div><p class="level-tag experienced">Exact zodiac geometry</p><h2>Aspect Calculator</h2><p>Enter two zodiac positions. The calculator converts them to absolute longitude, measures the shortest arc, and tests major and commonly used minor aspects.</p></div></div>
      <div class="position-grid">
        <fieldset><legend>Point A</legend><label>Sign <select data-a-sign>{signs.map(([,name])=><option>{name}</option>)}</select></label><label>Degree <input data-a-degree type="number" min="0" max="29" value="10" /></label><label>Minute <input data-a-minute type="number" min="0" max="59" value="0" /></label><label>Daily motion ° <input data-a-motion type="number" step=".01" value="1" /></label></fieldset>
        <fieldset><legend>Point B</legend><label>Sign <select data-b-sign>{signs.map(([,name])=><option>{name}</option>)}</select></label><label>Degree <input data-b-degree type="number" min="0" max="29" value="10" /></label><label>Minute <input data-b-minute type="number" min="0" max="59" value="0" /></label><label>Daily motion ° <input data-b-motion type="number" step=".01" value="0" /></label></fieldset>
        <fieldset class="orb-controls"><legend>Method</legend><label>Maximum orb <input data-max-orb type="range" min=".5" max="10" step=".5" value="6" /><output data-orb-output>6°</output></label><label class="check"><input data-minor type="checkbox" /> Include minor aspects</label><small>Daily motion is optional. Use a negative value for retrograde motion.</small></fieldset>
      </div>
      <article class="calculation-result" data-calculation-result aria-live="polite"></article>
      <details><summary>Calculation method and limitations</summary><p>Longitude = sign index × 30° + degree + minutes ÷ 60. Separation is the shortest arc from 0° to 180°. Orb is the absolute difference between that separation and the exact aspect angle. Applying or separating is estimated from the signed daily motions you provide; without correct motion values, that status is not reliable.</p><p><a href="https://www.astro.com/astrowiki/en/Aspect">Aspect geometry reference</a> · <a href="https://www.astro.com/astrowiki/en/Orb">Why orb policies vary</a></p></details>
    </section>
    <section id="condition-panel" role="tabpanel" aria-labelledby="condition-tab" data-conditions={JSON.stringify(traditionalConditions)} hidden>
      <div class="tool-heading"><div><p class="level-tag experienced">Traditional reference</p><h2>Planetary Condition by Sign</h2><p>Check domicile, detriment, exaltation, and fall for the seven traditional planets.</p></div></div>
      <div class="condition-controls"><label>Planet <select data-condition-planet>{Object.keys(traditionalConditions).map(name=><option>{name}</option>)}</select></label><label>Sign <select data-condition-sign>{signs.map(([,name])=><option>{name}</option>)}</select></label></div>
      <article class="calculation-result" data-condition-result aria-live="polite"></article>
      <aside class="method-note"><strong>Important:</strong> This is a sign-level condition reference, not a complete dignity score. A fuller traditional assessment may add triplicity, bounds, face, sect, house placement, speed, solar phase, aspects, reception, and other accidental conditions. Outer-planet rulerships are excluded because this tool uses the traditional seven-planet scheme. <a href="https://www.astro.com/astrowiki/en/Essential_Dignities">Read the dignity reference</a>.</aside>
    </section>
    <section id="placement-panel" role="tabpanel" aria-labelledby="placement-tab" hidden>
      <div class="tool-heading"><div><p class="level-tag experienced">Synthesis practice</p><h2>Placement Builder</h2><p>Combine one planet, sign, and house to practice structured interpretation.</p></div></div>
      <div class="builder-controls">
        <label>Planet <select data-planet>{planets.map(([symbol,name,keywords,action]) => <option value={name} data-symbol={symbol} data-keywords={keywords} data-action={action}>{symbol} {name}</option>)}</select></label>
        <label>Sign <select data-sign>{signs.map(([symbol,name,type,style]) => <option value={name} data-symbol={symbol} data-type={type} data-style={style}>{symbol} {name}</option>)}</select></label>
        <label>House <select data-house>{houses.map(([number,meaning]) => <option value={number} data-meaning={meaning}>House {number} · {meaning}</option>)}</select></label>
      </div>
      <article class="synthesis" aria-live="polite" data-synthesis></article>
      <aside class="method-note"><strong>Method note:</strong> This builder teaches syntax, not a personal reading. A real interpretation also considers degree, aspects, rulers, planetary condition, the rest of the chart, technique, and lived context.</aside>
    </section>
  </div></section>
</BaseLayout>
<script>
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('.lab-tabs [role="tab"]')];
  const activateTab=(tab:HTMLButtonElement)=>{tabs.forEach((item)=>{const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;const panel=document.getElementById(item.getAttribute('aria-controls')||'');if(panel)panel.hidden=!active;});};
  tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activateTab(tab));tab.addEventListener('keydown',(event)=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:event.key==='ArrowRight'?(index+1)%tabs.length:(index-1+tabs.length)%tabs.length;activateTab(tabs[next]);tabs[next].focus();});});
  const search=document.querySelector<HTMLInputElement>('[data-glyph-search]'),glyphCards=[...document.querySelectorAll<HTMLElement>('[data-glyph]')],count=document.querySelector<HTMLElement>('[data-glyph-count]'),glyphEmpty=document.querySelector<HTMLElement>('[data-glyph-empty]');
  search?.addEventListener('input',()=>{const term=search.value.trim().toLowerCase();let shown=0;glyphCards.forEach(card=>{const match=!term||(card.dataset.glyph||'').includes(term);card.hidden=!match;if(match)shown++;});if(count)count.textContent=shown+' '+(shown===1?'symbol':'symbols')+' shown';if(glyphEmpty)glyphEmpty.hidden=shown!==0;});
  const aspectRoot=document.querySelector<HTMLElement>('[data-aspects]'),aspectResult=document.querySelector<HTMLElement>('[data-calculation-result]'),orbInput=document.querySelector<HTMLInputElement>('[data-max-orb]'),orbOutput=document.querySelector<HTMLOutputElement>('[data-orb-output]'),minorInput=document.querySelector<HTMLInputElement>('[data-minor]');
  const aspectData=JSON.parse(aspectRoot?.dataset.aspects||'[]'),signNames=[...document.querySelectorAll<HTMLOptionElement>('[data-a-sign] option')].map(option=>option.value);
  const field=(name:string)=>document.querySelector<HTMLInputElement>('[data-'+name+']');
  const selectField=(name:string)=>document.querySelector<HTMLSelectElement>('[data-'+name+']');
  const longitude=(prefix:string)=>signNames.indexOf(selectField(prefix+'-sign')?.value||'')*30+Number(field(prefix+'-degree')?.value||0)+Number(field(prefix+'-minute')?.value||0)/60;
  const separation=(a:number,b:number)=>{const raw=Math.abs(a-b)%360;return raw>180?360-raw:raw;};
  const renderCalculation=()=>{if(!aspectResult||!orbInput)return;const values=['a-degree','a-minute','b-degree','b-minute'].map(name=>Number(field(name)?.value));if(values[0]<0||values[0]>29||values[2]<0||values[2]>29||values[1]<0||values[1]>59||values[3]<0||values[3]>59){aspectResult.innerHTML='<h3>Check the positions</h3><p>Degrees must be 0–29 and minutes must be 0–59.</p>';return;}const a=longitude('a'),b=longitude('b'),sep=separation(a,b),maxOrb=Number(orbInput.value),allowed=aspectData.filter((item:any)=>minorInput?.checked||[0,60,90,120,180].includes(item.angle)),nearest=allowed.map((item:any)=>({...item,difference:Math.abs(sep-item.angle)})).sort((x:any,y:any)=>x.difference-y.difference)[0];if(orbOutput)orbOutput.value=maxOrb+'°';const aSign=signNames.indexOf(selectField('a-sign')?.value||''),bSign=signNames.indexOf(selectField('b-sign')?.value||''),signDistance=Math.min(Math.abs(aSign-bSign),12-Math.abs(aSign-bSign)),expected=nearest.angle/30,dissociate=[0,2,3,4,6].includes(expected)&&signDistance!==expected;const motionA=Number(field('a-motion')?.value||0),motionB=Number(field('b-motion')?.value||0),futureSep=separation(a+motionA*.01,b+motionB*.01),phase=Math.abs(futureSep-nearest.angle)<nearest.difference?'Applying':Math.abs(futureSep-nearest.angle)>nearest.difference?'Separating':'Stationary relative motion',within=nearest.difference<=Math.min(maxOrb,nearest.orb);aspectResult.innerHTML='<p class="level-tag experienced">Calculated result</p><h3>'+a.toFixed(2)+'° and '+b.toFixed(2)+'° · separation '+sep.toFixed(2)+'°</h3>'+(within?'<p><strong>'+nearest.symbol+' '+nearest.name+'</strong> with an orb of '+nearest.difference.toFixed(2)+'°. '+phase+'.</p><p>'+(dissociate?'<strong>Out-of-sign/dissociate:</strong> The degree aspect is within orb, but the signs do not have its usual relationship.':'The degree relationship and sign relationship agree.')+'</p>':'<p>No selected aspect is within the allowed orb. The nearest is '+nearest.name+', '+nearest.difference.toFixed(2)+'° from exact.</p>')+'<dl><div><dt>Point A longitude</dt><dd>'+a.toFixed(2)+'°</dd></div><div><dt>Point B longitude</dt><dd>'+b.toFixed(2)+'°</dd></div><div><dt>Shortest arc</dt><dd>'+sep.toFixed(2)+'°</dd></div><div><dt>Orb policy</dt><dd>'+maxOrb+'° maximum; '+(minorInput?.checked?'major + minor':'major only')+'</dd></div></dl>';};
  aspectRoot?.querySelectorAll('input,select').forEach(control=>control.addEventListener('input',renderCalculation));renderCalculation();
  const conditionRoot=document.querySelector<HTMLElement>('[data-conditions]'),conditionResult=document.querySelector<HTMLElement>('[data-condition-result]'),conditionPlanet=selectField('condition-planet'),conditionSign=selectField('condition-sign'),conditionData=JSON.parse(conditionRoot?.dataset.conditions||'{}');
  const signRulers:Record<string,string>={Aries:'Mars',Taurus:'Venus',Gemini:'Mercury',Cancer:'Moon',Leo:'Sun',Virgo:'Mercury',Libra:'Venus',Scorpio:'Mars',Sagittarius:'Jupiter',Capricorn:'Saturn',Aquarius:'Saturn',Pisces:'Jupiter'};
  const signCondition=(planetName:string,signName:string)=>{const record=conditionData[planetName];if(!record)return[];const statuses:string[]=[];if(record.domicile.includes(signName))statuses.push('Domicile');if(record.exaltation.includes(signName))statuses.push('Exaltation');if(record.detriment.includes(signName))statuses.push('Detriment');if(record.fall.includes(signName))statuses.push('Fall');return statuses;};
  const renderCondition=()=>{if(!conditionResult||!conditionPlanet||!conditionSign)return;const signValue=conditionSign.value,statuses=signCondition(conditionPlanet.value,signValue);const descriptions:Record<string,string>={Domicile:'The planet is in a sign it traditionally rules and has access to its own resources.',Exaltation:'The planet holds a position of honor in this sign, though this is not identical to domicile.',Detriment:'The planet is opposite a domicile and must operate through an environment unlike its own.',Fall:'The planet is opposite its exaltation and is traditionally considered lowered in status.'};conditionResult.innerHTML='<p class="level-tag experienced">Traditional sign-level result</p><h3>'+conditionPlanet.value+' in '+signValue+'</h3>'+(statuses.length?statuses.map(status=>'<p><strong>'+status+':</strong> '+descriptions[status]+'</p>').join(''):'<p>No domicile, detriment, exaltation, or fall applies at the sign level. Do not label the planet peregrine until triplicity, bounds, and face have also been checked.</p>')+'<p><strong>Dispositor:</strong> '+signRulers[signValue]+' traditionally rules '+signValue+'. Examine that planet’s sign, house, condition, and aspects to follow the chain.</p>';};
  [conditionPlanet,conditionSign].forEach(control=>control?.addEventListener('change',renderCondition));renderCondition();
  const planet=document.querySelector<HTMLSelectElement>('[data-planet]'),sign=document.querySelector<HTMLSelectElement>('[data-sign]'),house=document.querySelector<HTMLSelectElement>('[data-house]'),output=document.querySelector<HTMLElement>('[data-synthesis]');
  const renderPlacement=()=>{if(!planet||!sign||!house||!output)return;const po=planet.selectedOptions[0],so=sign.selectedOptions[0],ho=house.selectedOptions[0],statuses=signCondition(planet.value,sign.value),conditionText=statuses.length?' At the sign level, its traditional condition is <strong>'+statuses.join(' and ')+'</strong>.':' No domicile, exaltation, detriment, or fall applies at this sign level.';output.innerHTML='<p class="level-tag newcomer">Your practice sentence</p><h3>'+po.dataset.symbol+' '+planet.value+' in '+so.dataset.symbol+' '+sign.value+', House '+house.value+'</h3><p><strong>What:</strong> '+planet.value+' represents '+po.dataset.keywords+'; consider '+po.dataset.action+'.</p><p><strong>How:</strong> '+sign.value+' is '+so.dataset.type+' and tends to express in a '+so.dataset.style+' manner.'+conditionText+'</p><p><strong>Where:</strong> House '+house.value+' brings the conversation to '+ho.dataset.meaning?.toLowerCase()+'.</p><p><strong>Follow the ruler:</strong> '+signRulers[sign.value]+' is the traditional dispositor of this placement. Its own position describes how the placement gets support and direction.</p><details><summary>Experienced synthesis prompt</summary><p>How does the sign help or complicate the planet’s function? What condition is the house ruler in, and does the theme repeat elsewhere?</p></details><details><summary>Expert synthesis prompt</summary><p>Specify house system and rulership scheme, then evaluate dignity, sect, phase, angularity, reception, close aspects, and applicable timing techniques.</p></details>';};
  [planet,sign,house].forEach(select=>select?.addEventListener('change',renderPlacement));renderPlacement();
</script>
<style>
  .lab{max-width:68rem}.lab-tabs{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:.5rem}.lab-tabs button{min-height:3rem;padding:.65rem 1rem;border:1px solid var(--stone);border-radius:999px;background:var(--paper-light);white-space:nowrap}.lab-tabs button[aria-selected='true']{border-color:var(--navy);background:var(--navy);color:var(--white)}[role='tabpanel']{padding-top:var(--space-6)}
  .tool-heading{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);margin-bottom:var(--space-4)}label{display:grid;gap:.35rem;color:var(--navy-soft);font-size:var(--step--1);font-weight:800}input,select{min-height:3rem;padding:.65rem .8rem;border:1px solid var(--stone);border-radius:.45rem;background:var(--white);color:var(--navy)}
  .level-tag{width:fit-content;margin-bottom:.5rem;padding:.2rem .55rem;border-radius:999px;color:var(--navy);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.newcomer{background:#dfe9df}.experienced{background:#e3e8ee}.result-count{font-weight:800}
  .glyph-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.glyph-grid article{display:grid;grid-template-columns:3rem 1fr;gap:.75rem;align-items:center;padding:1rem;border:1px solid var(--stone);border-radius:var(--radius-md);background:var(--paper-light)}.glyph-grid article>span{font-size:2rem;text-align:center}.glyph-grid h3,.glyph-grid p{margin:0}.glyph-grid h3{font-size:1.15rem}.glyph-grid small{color:var(--clay);font-weight:800;text-transform:uppercase}
  .position-grid{display:grid;grid-template-columns:1fr 1fr .8fr;gap:1rem}.position-grid fieldset{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin:0;padding:1rem;border:1px solid var(--stone);border-radius:var(--radius-md);background:var(--paper-light)}.position-grid legend{padding-inline:.4rem;font-family:var(--serif);font-size:var(--step-1);font-weight:700}.position-grid .orb-controls{display:flex;flex-direction:column}.check{display:flex;align-items:center;gap:.6rem}.check input{width:1.25rem;height:1.25rem;min-height:auto}.calculation-result{margin-top:var(--space-5);padding:clamp(1.25rem,4vw,2rem);border-top:.35rem solid var(--cobalt);border-radius:var(--radius-md);background:var(--paper-light);box-shadow:var(--shadow)}.calculation-result dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.calculation-result dl div{padding:.75rem;border:1px solid var(--stone);border-radius:.45rem}.calculation-result dt{font-size:.72rem;font-weight:800;text-transform:uppercase}.calculation-result dd{margin:.25rem 0 0}.condition-controls{display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:38rem}details{margin-top:.75rem;padding:.8rem;border:1px solid var(--stone);border-radius:.45rem;background:var(--paper-light)}summary{cursor:pointer;font-weight:800}
  .builder-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.synthesis{margin-top:var(--space-5);padding:clamp(1.25rem,4vw,2.25rem);border-top:.35rem solid var(--coral);border-radius:var(--radius-md);background:var(--paper-light);box-shadow:var(--shadow)}.method-note{margin-top:1rem;padding:1rem;border-left:3px solid var(--gold);background:var(--paper)}
  @media(max-width:760px){.tool-heading{align-items:stretch;flex-direction:column}.glyph-grid{grid-template-columns:1fr 1fr}.position-grid,.condition-controls,.builder-controls{grid-template-columns:1fr}.calculation-result dl{grid-template-columns:1fr 1fr}}@media(max-width:480px){.glyph-grid,.calculation-result dl{grid-template-columns:1fr}}
</style>
