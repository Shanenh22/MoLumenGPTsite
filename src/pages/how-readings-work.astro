---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const steps = [
  ['Choose a reading', 'Compare the verified services or use the Reading Finder.'],
  [
    'Review and schedule',
    'See the price, duration, format, required information, and policies before choosing a time.',
  ],
  [
    'Share what is needed',
    'Submit birth details and your focus through the approved booking provider—not through analytics or this site.',
  ],
  ['Mo prepares', 'Mo calculates and studies the relevant charts before you meet.'],
  [
    'Meet and explore',
    'Talk through the chart in connection with your real questions and circumstances.',
  ],
  [
    'Take the perspective with you',
    'Your deliverables and follow-up details will be stated clearly before booking.',
  ],
];
---

<BaseLayout title="How Astrology Readings Work"
  ><PageHero
    eyebrow="The reading process"
    title="Thoughtful preparation. A real conversation."
    lede="Know what to expect before you decide to book."
  /><section class="section">
    <div class="container process-list">
      {
        steps.map((step, i) => (
          <article>
            <>
              <span>{i + 1}</span>
              <div>
                <>
                  <h2>{step[0]}</h2>
                  <p>{step[1]}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section><section class="section surface">
    <div class="container reading-width">
      <h2>Your birth details are sensitive.</h2><p>
        They are used to calculate and prepare charts. They should never be placed in URLs,
        analytics, the website repository, or browser storage.
      </p><a class="button" href="/prepare-for-your-reading/">How to prepare</a>
    </div>
  </section></BaseLayout
><style>
  .process-list {
    max-width: 55rem;
  }
  .process-list article {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--stone);
  }
  .process-list span {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-content: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--clay);
    font-family: var(--serif);
  }
  .process-list h2 {
    font-size: var(--step-2);
  }
</style>
