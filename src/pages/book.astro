---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/services';
---

<BaseLayout title="Book a Reading" noindex
  ><PageHero
    eyebrow="Booking"
    title="Review everything before you choose a time."
    lede="Choose a service, review its eligibility, duration, and price, then continue to scheduling when the booking connection is activated."
  /><section class="section">
    <div class="container booking-layout">
      <div>
        <h2>Choose a verified reading</h2><div class="booking-services">
          {
            services.map((service) => (
              <a href={`/readings/${service.slug}/`}>
                <>
                  <strong>{service.shortName}</strong>
                  <span>
                    {service.duration} · {service.price}
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </div><aside class="card">
        <p class="eyebrow">Integration not yet active</p><h2>
          No payment will be taken on this staging page.
        </h2><p>
          Services and prices are now confirmed. Scheduling and payment remain disabled until the
          Cal.com event links and booking policies are connected and tested.
        </p><a class="button secondary" href="/contact/">Ask Mo a question</a>
      </aside>
    </div>
  </section></BaseLayout
><style>
  .booking-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-7);
    align-items: start;
  }
  .booking-services {
    display: grid;
    gap: 0.75rem;
  }
  .booking-services a {
    display: grid;
    padding: 1rem 1.25rem;
    border: 1px solid var(--stone);
    border-radius: var(--radius-md);
    background: var(--paper-light);
    text-decoration: none;
  }
  .booking-services span {
    color: var(--brown);
    font-size: var(--step--1);
  }
  @media (max-width: 760px) {
    .booking-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
