---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Credentials"
  ><PageHero
    eyebrow="Credentials"
    title="Study, practice, and professional community."
    lede="These statements come from Mo’s current website and must be reconfirmed before staging approval."
  /><section class="section">
    <div class="container reading-width">
      <div class="notice">
        <strong>Owner review required:</strong> Current certification levels, offices, and memberships
        may have changed.
      </div><ul class="credential-list">
        <li>Practitioner’s Certificate in Horary Astrology, School of Traditional Astrology</li><li>
          NCGR-PAA Level 1 and Level 2 certification exams
        </li><li>
          Published site states Treasurer and Board Member of OPA and Treasurer of NCGR-DFW
        </li><li>Published site states membership in NCGR, OPA, and ISAR</li>
      </ul>
    </div>
  </section></BaseLayout
><style>
  .credential-list {
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }
  .credential-list li {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--stone);
    font-family: var(--serif);
    font-size: var(--step-1);
  }
</style>
