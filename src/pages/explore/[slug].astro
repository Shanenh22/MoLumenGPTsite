---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { topics, topicFrameworks } from '../../data/learn';
export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
const framework = topicFrameworks[topic.slug];
---

<BaseLayout title={topic.title} description={topic.answer}
  ><PageHero eyebrow="Classical astrology library" title={topic.title} lede={topic.answer} /><section
    class="section"
  >
    <article class="container reading-width prose">
      <div class="framework-grid" aria-label="Three lenses for this topic">
        <article><p class="lens-label">01 · Astronomy</p><h2>What is measured</h2><p>{framework.astronomy}</p></article>
        <article><p class="lens-label">02 · Tradition</p><h2>What is inherited</h2><p>{framework.tradition}</p></article>
        <article><p class="lens-label">03 · Mo’s synthesis</p><h2>How Mo reads it</h2><p>{framework.mo}</p><a href="/reading-finder/">Bring your chart to a reading →</a></article>
      </div>
      <nav class="level-nav" aria-label="Choose reading depth"><a href="#newcomer">Newcomer</a><a href="#experienced">Experienced</a><a href="#expert">Expert</a></nav>
      <section class="level level-new" id="newcomer"><p class="level-label">Newcomer · Begin here</p><h2>A practical way to begin</h2><p>{topic.newcomer}</p><p class="prompt"><strong>Study prompt:</strong> {topic.prompt}</p></section>
      <details class="level" id="experienced"><summary><span>Experienced</span> Build interpretive confidence</summary><div><p>{topic.experienced}</p><p>No single symbol defines a person. Look for context, relationship, repetition, and the life someone is actually living.</p></div></details>
      <details class="level level-expert" id="expert"><summary><span>Expert</span> Examine method and technique</summary><div><p>{topic.expert}</p><p><strong>Technical vocabulary:</strong> {topic.terms.join(' · ')}</p></div></details>
      <aside class="reference-card"><p class="level-label">Reference standard</p><h2>How to use this page</h2><p>Astronomical positions and geometric relationships are facts that can be calculated. Their astrological meaning is interpretive and varies by school. Always name the method being used.</p></aside>
      <h2>Keep exploring</h2><p>Return to the larger chart and connect this topic naturally with planets, signs, houses, aspects, and timing.</p><div class="button-row">
        <a class="button secondary" href="/explore/">All topics</a><a
          class="button"
          href="/tools/astrology-lab/">Open the Astrology Lab</a
        >
      </div>
    </article>
  </section></BaseLayout
>
<style>
  .framework-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; margin-bottom: var(--space-6); }
  .framework-grid article { padding: var(--space-4); border: 1px solid var(--stone); border-radius: var(--radius-md); background: var(--paper-light); }
  .framework-grid article:nth-child(2) { border-top: .3rem solid var(--gold); }
  .framework-grid article:nth-child(3) { border-top: .3rem solid var(--coral); }
  .framework-grid h2 { font-size: var(--step-1); }
  .lens-label { color: var(--clay); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .level-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: var(--space-5); }
  .level-nav a { padding: .5rem .8rem; border: 1px solid var(--stone); border-radius: 999px; background: var(--paper-light); font-size: var(--step--1); font-weight: 800; text-decoration: none; }
  .level { margin-block: var(--space-4); padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--stone); border-radius: var(--radius-md); background: var(--paper-light); scroll-margin-top: 7rem; }
  .level-new { border-top: .35rem solid var(--sage); }
  .level-expert { border-top: .35rem solid var(--cobalt); }
  .level-label { margin-bottom: .5rem; color: var(--clay); font-size: var(--step--1); font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  summary { cursor: pointer; font-family: var(--serif); font-size: var(--step-1); font-weight: 700; }
  summary span { display: inline-block; margin-right: .6rem; color: var(--clay); font-family: var(--sans); font-size: var(--step--1); letter-spacing: .08em; text-transform: uppercase; }
  details > div { padding-top: 1rem; }
  .prompt { padding-left: 1rem; border-left: 3px solid var(--gold); }
  .reference-card { margin-block: var(--space-6); padding: var(--space-5); border-radius: var(--radius-md); background: var(--navy); color: var(--ivory); }
  .reference-card h2 { font-size: var(--step-2); }
  @media (max-width: 760px) { .framework-grid { grid-template-columns: 1fr; } }
</style>
