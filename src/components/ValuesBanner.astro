---
const values = [
  ['✣', 'Insight', 'See the patterns with clarity'],
  ['✧', 'Empowerment', 'Make choices aligned with your truth'],
  ['♡', 'Compassion', 'A safe space to be fully yourself'],
  ['♧', 'Growth', 'Navigate change and step into possibility'],
  ['☼', 'Practical wisdom', 'Grounded guidance for real life'],
  ['⌖', 'Your unique path', 'Honoring your story, your timing, your way'],
];
---

<section class="values-banner" aria-labelledby="values-heading">
  <div class="container">
    <h2 id="values-heading" class="sr-only">What guides Mo’s work</h2>
    <ul>
      {values.map(([icon, title, description], index) => (
        <li>
          <span class={`value-icon tone-${(index % 3) + 1}`} aria-hidden="true">{icon}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values-banner { padding-block: clamp(1rem, 2.5vw, 1.75rem); border-bottom: 1px solid var(--stone); background: var(--paper-light); }
  ul { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  li { min-width: 0; text-align: center; }
  .value-icon { display: grid; width: 4rem; aspect-ratio: 1; margin: 0 auto .65rem; place-items: center; border: 1px solid var(--gold-light); border-radius: 50%; color: var(--navy-soft); font-size: 1.1rem; background: #f1e7d3; }
  .tone-2 { border-color: #d7b5a7; background: #f2e3dc; }
  .tone-3 { border-color: #aebccc; background: #e5e8e9; }
  h3 { margin-bottom: .55rem; font-family: var(--sans); font-size: .82rem; font-weight: 800; letter-spacing: .11em; line-height: 1.3; text-transform: uppercase; }
  p { margin: 0 auto; color: var(--navy-soft); font-size: .86rem; line-height: 1.45; }
  @media (max-width: 960px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.25rem; } }
  @media (max-width: 560px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem .4rem; } .value-icon { width: 2.8rem; margin-bottom: .4rem; font-size: .9rem; } h3 { font-size: .65rem; letter-spacing: .06em; } p { font-size: .67rem; line-height: 1.35; } }
</style>
