---
import { footerGroups, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <img class="footer-logo" src="/images/mo-lumen-logo.png" alt={site.name} width="316" height="193" loading="lazy" decoding="async" />
      <p>
        Warm, practical astrology with a classical lens. Perspective for your choices—not a verdict.
      </p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {
      footerGroups.map((group) => (
        <nav aria-label={`${group.title} links`}>
          <h3>{group.title}</h3>
          {group.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="container newsletter-strip">
    <div><p class="eyebrow">Letters from Mo</p><h2>The sky, explained without panic.</h2></div>
    <a class="button light" href="/newsletter/">Join the newsletter</a>
  </div>
  <div class="container legal-row">
    <p>© {new Date().getFullYear()} {site.legalName}</p>
    <nav aria-label="Legal links">
      <a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a
      >
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-7);
    background: var(--navy);
    color: var(--ivory);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-6);
  }
  .footer-intro {
    max-width: 24rem;
  }
  .footer-logo { width: min(13rem, 80%); height: auto; margin-bottom: 1rem; }
  .site-footer h2 {
    font-size: var(--step-2);
  }
  .site-footer h3 {
    margin-bottom: 1rem;
    color: var(--gold-light);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-footer nav a {
    display: block;
    margin-block: 0.6rem;
    color: inherit;
    text-decoration: none;
  }
  .newsletter-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: var(--space-7);
    padding-block: var(--space-6);
    border-block: 1px solid rgba(247, 241, 231, 0.2);
  }
  .newsletter-strip .eyebrow {
    color: var(--gold-light);
  }
  .newsletter-strip h2 {
    margin: 0;
  }
  .legal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: var(--space-4);
    color: rgba(247, 241, 231, 0.72);
    font-size: var(--step--1);
  }
  .legal-row p {
    margin: 0;
  }
  .legal-row nav {
    display: flex;
    gap: 1.25rem;
  }
  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-intro {
      grid-column: 1 / -1;
    }
    .newsletter-strip,
    .legal-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-intro {
      grid-column: auto;
    }
  }
</style>
