---
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Mo Lumen Astrology, home">
      <img class="brand-icon" src="/images/brand-mark.png" alt="" width="256" height="256" decoding="async" />
      <span class="brand-copy"><strong>Mo Lumen</strong><small>Astrology</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/readings/" aria-current={isCurrent('/readings/') ? 'page' : undefined}>Readings</a>
      <details class="nav-dropdown">
        <summary>Classical Astrology <span aria-hidden="true">⌄</span></summary>
        <div class="dropdown-panel">
          <p>Classical foundation</p>
          <a href="/explore/essential-dignities/">Essential Dignities <small>Planetary capacity and support</small></a>
          <a href="/explore/sect/">Sect <small>Day and night chart doctrine</small></a>
          <a href="/explore/planetary-joys/">Planetary Joys <small>The classical architecture of houses</small></a>
          <p class="dropdown-group">Library &amp; practice</p>
          <a href="/explore/" aria-current={isCurrent('/explore/') ? 'page' : undefined}>Classical Library <small>Astronomy, tradition, and Mo’s synthesis</small></a>
          <a href="/tools/astrology-lab/" aria-current={isCurrent('/tools/astrology-lab/') ? 'page' : undefined}>Astrology Lab <small>Geometry, condition, and synthesis</small></a>
          <div class="dropdown-secondary"><a href="/current-sky/">Current Sky</a><a href="/videos/">Videos</a></div>
        </div>
      </details>
      <a href="/blog/" aria-current={isCurrent('/blog/') ? 'page' : undefined}>Blog</a>
      <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About Mo</a>
      <a class="button" href="/book/" aria-current={isCurrent('/book/') ? 'page' : undefined}>Book a Reading</a>
    </nav>
    <div class="mobile-actions">
      <a class="mobile-book" href="/book/">Book</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span>Menu</span><span class="menu-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu-inner" role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="mobile-menu-top">
        <div><span class="eyebrow">Explore Mo Lumen</span><p>Where would you like to go?</p></div>
        <button class="close-button" type="button">Close <span aria-hidden="true">×</span></button>
      </div>
      <nav aria-label="Mobile navigation">
        <p class="mobile-nav-label">Choose a reading</p>
        <a href="/reading-finder/"><span class="nav-number">01</span><span>Find Your Reading</span><span aria-hidden="true">↗</span></a>
        <a href="/readings/"><span class="nav-number">02</span><span>Compare Readings</span><span aria-hidden="true">↗</span></a>
        <p class="mobile-nav-label">Classical astrology</p>
        <a href="/explore/"><span class="nav-number">03</span><span>Classical Library</span><span aria-hidden="true">↗</span></a>
        <a href="/tools/astrology-lab/"><span class="nav-number">04</span><span>Astrology Lab</span><span aria-hidden="true">↗</span></a>
        <a href="/current-sky/"><span class="nav-number">05</span><span>Current Sky</span><span aria-hidden="true">↗</span></a>
        <a href="/blog/"><span class="nav-number">06</span><span>Blog</span><span aria-hidden="true">↗</span></a>
        <p class="mobile-nav-label">Meet &amp; connect</p>
        <a href="/about/"><span class="nav-number">07</span><span>About Mo</span><span aria-hidden="true">↗</span></a>
        <a href="/contact/"><span class="nav-number">08</span><span>Contact</span><span aria-hidden="true">↗</span></a>
      </nav>
      <div class="mobile-menu-footer">
        <div class="menu-mo"><img src="/images/mo-5.webp" alt="" width="64" height="64" loading="lazy" /><p><span aria-hidden="true">✦</span> Perspective for real life</p></div>
        <a class="button light" href="/book/" aria-current={isCurrent('/book/') ? 'page' : undefined}>Book a Reading</a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  const close = document.querySelector<HTMLButtonElement>('.close-button');
  const desktopMenu = document.querySelector<HTMLDetailsElement>('.nav-dropdown');
  let previousFocus: HTMLElement | null = null;

  const focusable = () =>
    menu ? [...menu.querySelectorAll<HTMLElement>('a, button:not([disabled])')] : [];
  const openMenu = () => {
    if (!button || !menu) return;
    previousFocus = document.activeElement as HTMLElement;
    menu.hidden = false;
    button.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    focusable()[0]?.focus();
  };
  const closeMenu = () => {
    if (!button || !menu) return;
    menu.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
    previousFocus?.focus();
  };
  button?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  menu?.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (!target.closest('a, button')) closeMenu();
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  const desktopQuery = window.matchMedia('(min-width: 1121px)');
  desktopQuery.addEventListener('change', (event) => {
    if (event.matches && menu && !menu.hidden) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && desktopMenu?.open) {
      desktopMenu.open = false;
      desktopMenu.querySelector('summary')?.focus();
    }
    if (menu?.hidden) return;
    if (event.key === 'Escape') closeMenu();
    if (event.key === 'Tab') {
      const items = focusable();
      const first = items[0];
      const last = items.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      }
      if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  document.addEventListener('click', (event) => {
    if (desktopMenu?.open && !desktopMenu.contains(event.target as Node)) desktopMenu.open = false;
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid rgba(216, 195, 154, 0.35);
    background: rgba(15, 31, 53, 0.97);
    backdrop-filter: blur(14px);
  }
  .header-inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
  }
  .brand:hover {
    color: var(--gold-light);
  }
  .brand-icon { width: 3.15rem; height: 3.15rem; flex: 0 0 auto; }
  .brand-copy strong, .brand-copy small { display: block; line-height: 1; }
  .brand-copy strong { color: var(--white); font-family: var(--serif); font-size: 1.35rem; font-weight: 600; letter-spacing: .015em; }
  .brand-copy small { margin-top: .35rem; color: var(--gold-light); font-size: .65rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.6rem);
    font-size: 0.9rem;
    color: var(--ivory);
  }
  .desktop-nav > a:not(.button) {
    text-decoration: none;
  }
  .desktop-nav > a:not(.button), .nav-dropdown summary { padding: .45rem .55rem; }
  .desktop-nav > a:not(.button):hover,
  .desktop-nav > a:not(.button):focus-visible,
  .nav-dropdown summary:hover,
  .nav-dropdown summary:focus-visible { border-radius: .35rem; background: var(--gold-light); color: var(--navy); }
  .nav-dropdown { position: relative; }
  .nav-dropdown summary { cursor: pointer; list-style: none; font-weight: 600; }
  .nav-dropdown summary::-webkit-details-marker { display: none; }
  .dropdown-panel { position: absolute; top: calc(100% + .75rem); left: 50%; width: 21rem; padding: 1rem; transform: translateX(-50%); border: 1px solid var(--gold-light); border-radius: var(--radius-md); background: var(--paper-light); color: var(--navy); box-shadow: var(--shadow); }
  .dropdown-panel::before { position: absolute; top: -.45rem; left: 50%; width: .8rem; height: .8rem; transform: translateX(-50%) rotate(45deg); border-left: 1px solid var(--gold-light); border-top: 1px solid var(--gold-light); background: var(--paper-light); content: ''; }
  .dropdown-panel p { margin: 0 0 .5rem; color: var(--clay); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .dropdown-panel .dropdown-group { margin-top: .8rem; padding-top: .7rem; border-top: 1px solid var(--stone); }
  .dropdown-panel > a { display: block; padding: .7rem; border-radius: .45rem; color: var(--navy); text-decoration: none; }
  .dropdown-panel > a:hover, .dropdown-panel > a:focus-visible { background: var(--paper); color: var(--navy); }
  .dropdown-panel > a[aria-current='page'] { border-left: .25rem solid var(--coral); background: var(--paper); }
  .dropdown-panel small { display: block; margin-top: .1rem; color: var(--navy-soft); font-size: .72rem; }
  .dropdown-secondary { display: flex; gap: 1rem; margin-top: .5rem; padding: .75rem .7rem 0; border-top: 1px solid var(--stone); }
  .dropdown-secondary a { color: var(--navy); font-size: .8rem; font-weight: 700; }
  .desktop-nav > a[aria-current='page']:not(.button) {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.45em;
  }
  .desktop-nav .button {
    min-height: 2.7rem;
    padding-inline: 1rem;
    border-color: var(--coral);
    background: var(--coral);
  }
  .menu-button {
    display: none;
    min-width: 3rem;
    min-height: 3rem;
    align-items: center;
    gap: 0.65rem;
    border: 0;
    background: transparent;
    font-weight: 700;
    color: var(--white);
  }
  .mobile-actions { display: none; align-items: center; gap: .25rem; }
  .mobile-book { padding: .7rem .85rem; border-radius: 999px; background: var(--coral); color: var(--white); font-size: .78rem; font-weight: 800; text-decoration: none; }
  .menu-lines,
  .menu-lines::before,
  .menu-lines::after {
    display: block;
    width: 1.35rem;
    height: 1px;
    background: var(--gold-light);
    content: '';
  }
  .menu-lines {
    position: relative;
  }
  .menu-lines::before {
    position: absolute;
    top: -0.38rem;
  }
  .menu-lines::after {
    position: absolute;
    top: 0.38rem;
  }
  .mobile-menu {
    position: fixed;
    z-index: 100;
    inset: 0;
    background: rgba(8, 18, 34, 0.72);
    backdrop-filter: blur(8px);
  }
  .mobile-menu-inner {
    display: flex;
    width: min(100%, 28rem);
    min-height: 100dvh;
    margin-left: auto;
    flex-direction: column;
    padding: max(1.25rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(1.25rem, env(safe-area-inset-bottom)) 1.25rem;
    background:
      linear-gradient(180deg, rgba(15, 31, 53, 0.92), rgba(15, 31, 53, 0.99)),
      url('/images/dusk-mountains.webp') center / cover;
    color: var(--ivory);
    box-shadow: var(--shadow);
  }
  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mobile-menu .eyebrow {
    margin: 0;
    color: var(--gold-light);
  }
  .mobile-menu-top p { margin: .25rem 0 0; color: rgba(255,253,248,.72); font-size: .82rem; }
  .close-button {
    min-width: 3rem;
    min-height: 3rem;
    border: 0;
    background: transparent;
    color: var(--ivory);
  }
  .close-button span {
    font-size: 1.7rem;
  }
  .mobile-menu nav {
    display: grid;
    margin-block: 1rem;
    overflow-y: auto;
  }
  .mobile-menu nav a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding-block: 0.52rem;
    border-bottom: 1px solid rgba(247, 241, 231, 0.2);
    font-family: var(--serif);
    font-size: clamp(1.05rem, 4.4vw, 1.35rem);
    text-decoration: none;
  }
  .mobile-menu nav a:hover, .mobile-menu nav a:focus-visible { padding-inline: .5rem; background: var(--gold-light); color: var(--navy); }
  .mobile-nav-label { margin: .8rem 0 0; color: var(--gold-light); font-size: .65rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .mobile-menu nav a[aria-current='page'] {
    color: var(--gold-light);
  }
  .nav-number {
    display: grid;
    width: 1.9rem;
    height: 1.9rem;
    place-items: center;
    border-radius: 50%;
    background: var(--coral);
    color: var(--white);
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }
  .mobile-menu nav a:nth-child(3n + 2) .nav-number { background: var(--cobalt); }
  .mobile-menu nav a:nth-child(3n) .nav-number { background: var(--saffron); color: var(--navy); }
  .mobile-menu-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(247, 241, 231, 0.2);
  }
  .mobile-menu-footer p { margin: 0; color: var(--gold-light); font-size: 0.75rem; }
  .menu-mo { display: flex; align-items: center; gap: .75rem; }
  .menu-mo img { width: 2.75rem; height: 2.75rem; border: 2px solid var(--gold-light); border-radius: 50%; object-fit: cover; object-position: center 30%; }
  .mobile-menu-footer .button { min-height: 2.7rem; font-size: 0.82rem; }
  @media (max-width: 420px) {
    .mobile-menu-footer { grid-template-columns: 1fr; }
    .mobile-menu-footer p { display: none; }
  }
  @media (max-width: 1120px) {
    .desktop-nav {
      display: none;
    }
    .menu-button {
      display: flex;
    }
    .mobile-actions { display: flex; }
    .brand-icon { width: 2.8rem; height: 2.8rem; }
    .brand-copy strong { font-size: 1.15rem; }
  }
  @media (max-width: 390px) {
    .brand { gap: .5rem; }
    .brand-icon { width: 2.55rem; height: 2.55rem; }
    .brand-copy strong { font-size: 1.05rem; }
    .brand-copy small { font-size: .55rem; letter-spacing: .15em; }
    .mobile-book { padding-inline: .7rem; }
    .menu-button { gap: .4rem; padding-inline: .35rem; }
  }
</style>
