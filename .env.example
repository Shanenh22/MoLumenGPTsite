# Canonical public origin. Use the staging URL until production launch approval.
PUBLIC_SITE_URL=https://example.pages.dev

# Optional Google Analytics 4 measurement ID. Leave blank to disable analytics.
PUBLIC_GA_MEASUREMENT_ID=

# Cal.com username or full public booking base URL. Never put a secret here.
PUBLIC_CALCOM_BASE_URL=

# Optional public Stripe configuration only. Secret keys must never use PUBLIC_ variables.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# MailerLite public embedded-form identifiers. Keep API tokens server-side and out of Git.
PUBLIC_MAILERLITE_ACCOUNT_ID=
PUBLIC_MAILERLITE_FORM_ID=

# Video and social configuration.
PUBLIC_YOUTUBE_CHANNEL_ID=
PUBLIC_YOUTUBE_PLAYLIST_ID=
PUBLIC_INSTAGRAM_PROFILE_URL=

